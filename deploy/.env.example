# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# Tailscale auth key for the `voxel-typer` device. Create it in the Tailscale admin console
# (Settings -> Keys -> Generate auth key): not ephemeral, tagged for this device (for example
# tag:voxel-typer). Reusable only if you also run the optional edge preview below.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Only for the optional `voxel-typer-edge` preview (commented out in docker-compose.yml).
# Leave empty to reuse TS_AUTHKEY (which must then be reusable).
TS_AUTHKEY_EDGE=

# Image tag the kids' instance follows. `stable` = the last milestone that passed its gate.
# To roll back, pin a milestone tag such as m2, then `docker compose up -d`.
VOXEL_TYPER_TAG=stable
