{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://voxel-typer.local/schemas/voxel-model.json",
  "title": "Voxel Typer voxel model",
  "description": "A creature built from boxes, with keyframe animations (contracts.md §8.4). Lengths are model pixels (16 = one block); rot keys are degrees. validate.ts adds the cross-reference checks a schema can't express.",
  "type": "object",
  "required": ["id", "parts", "anims"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/definitions/part" }
    },
    "anims": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/definitions/anim" }
    }
  },
  "definitions": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "size": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },
    "part": {
      "type": "object",
      "required": ["name", "size", "pivot", "offset"],
      "additionalProperties": false,
      "anyOf": [{ "required": ["color"] }, { "required": ["tile"] }],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "parent": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "size": { "$ref": "#/definitions/size" },
        "pivot": { "$ref": "#/definitions/vec3" },
        "offset": { "$ref": "#/definitions/vec3" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "tile": {
          "type": "object",
          "required": ["blockId", "face"],
          "additionalProperties": false,
          "properties": {
            "blockId": { "type": "string", "minLength": 1 },
            "face": { "enum": ["top", "side", "bottom"] }
          }
        }
      }
    },
    "anim": {
      "type": "object",
      "required": ["durationMs", "loop", "tracks"],
      "additionalProperties": false,
      "properties": {
        "durationMs": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean" },
        "tracks": { "type": "array", "items": { "$ref": "#/definitions/track" } }
      }
    },
    "track": {
      "type": "object",
      "required": ["part", "prop", "keys"],
      "additionalProperties": false,
      "properties": {
        "part": { "type": "string" },
        "prop": { "enum": ["rot", "pos", "scale"] },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["t", "v"],
            "additionalProperties": false,
            "properties": {
              "t": { "type": "number", "minimum": 0 },
              "v": { "$ref": "#/definitions/vec3" }
            }
          }
        }
      }
    }
  }
}
